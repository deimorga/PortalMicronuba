# Copiar como .env y rellenar. El .env NUNCA va a git.
# Lo leen docker-compose.yml (desarrollo) y docker-compose.prod.yml (producción).

# Opcional. Por defecto "/" (el portal se sirve desde la raíz del dominio).
# BASE_URL=/

# Servidor de correo saliente para el formulario de cotización
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=usuario@example.com
SMTP_PASS=cambiar
SMTP_SECURE=ssl

# Remitente y destinatario de las cotizaciones
MAIL_FROM_EMAIL=usuario@example.com
MAIL_FROM_NAME=Portal MicroNuba
MAIL_TO_EMAIL=contacto@micronuba.net
